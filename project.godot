[layer_names]

3d_physics/layer_1="player"
3d_physics/layer_2="water"
3d_physics/layer_3="constructible_ground"
3d_physics/layer_4="not_constructible_ground"
3d_physics/layer_9="trees"

[logging]

file_logging/enable_file_logging=true

[memory]

limits/message_queue/max_size_kb=16384

[network]

limits/debugger/max_chars_per_second=100000

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/continuous_cd_movement_threshold=0.5

[rendering]

renderer/rendering_method="mobile"
lights_and_shadows/use_physical_light_units=true
environment/defaults/default_clear_color=Color(0.2, 0.294118, 0.486275, 1)
environment/defaults/default_environment="res://default_env.tres"

[shader_globals]

wind_intensity={
"type": "float",
"value": 0.0
}
wind_direction={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
