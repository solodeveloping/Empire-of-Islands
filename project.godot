; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

"One_Click_Plugin_Reloader/Default Window"="Script"
"One_Click_Plugin_Reloader/Output panel notifications"=true

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="trading-empire"
config/version="0.01"
run/main_scene="res://RGT/Bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.7")
boot_splash/image="res://boot_splash.png"
config/icon="res://icon.png"
boot_splash/minimum_display_time=2000
addons/rakugo_game_template/loading_scene_path="res://scenes/LoadingScreen/LoadingScreen.tscn"
addons/rakugo_game_template/main_menu_path="res://scenes/MainMenu/MainMenu.tscn"
addons/rakugo_game_template/first_game_scene_path="res://scenes/Game/game.tscn"

[audio]

buses/default_bus_layout="uid://bfrjvaf03kwyl"

[autoload]

Entities="*res://theLudovyc/Entities.gd"
DebugMenu="*uid://cggqb75a8w8r"
ECS="*uid://dfqwl5njvdnmq"
PhantomCameraManager="*uid://duq6jhf6unyis"
AppSettings="*uid://dtdx30l1ls16e"
SceneLoader="*uid://hvk5xe04tvdh"
ProjectMusicController="*uid://r5t485lr3p7t"
UISoundManager="*uid://cc37235kj4384"
Transitions="*uid://b0w163uxufsvm"
SoundManager="*uid://b2br4fwxbj2s8"
Loggie="*uid://bmh2auo806k0k"

[debug]

gdscript/warnings/shadowed_variable=false
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/return_value_discarded=false
gdscript/warnings/integer_division=0
gdscript/warnings/int_as_enum_without_cast=0
settings/fps/force_fps=60

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"
settings/updates/check_for_updates=false
settings/telemetry_state=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

naming/default_signal_callback_name="_on_{NodeName}_{signal_name}"
naming/scene_name_casing=0

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/gaea/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/gecs/plugin.cfg", "res://addons/godotmarket/plugin.cfg", "res://addons/goshapes/plugin.cfg", "res://addons/loggie/plugin.cfg", "res://addons/mesh_inspector/plugin.cfg", "res://addons/o_c_p_r/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/rakugo_game_template/plugin.cfg", "res://addons/script-tabs/plugin.cfg", "res://addons/sound_manager/plugin.cfg")

[global_group]

ocean_surface_nav="group for ocean surface and navigation"

[gui]

theme/custom="res://Art/Theme/Theme.tres"
theme/custom_font="res://Art/Fonts/LinLibertine.ttf"

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": true,
"flags/anisotropic": false,
"flags/filter": true,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

